# Duren native SDL host (macOS / Linux) — not the Retro-Go ABI shim.
#
#   make host
#   ./Duren_host
#
# Requires: pkg-config, SDL2, SDL2_image.
# Runtime assets: host_data/ (PNG atlases + Duren.pak).

HOST_SDL   ?= 2
HOST_CC    ?= cc
HOST_BUILD_DIR := build/host/sdl$(HOST_SDL)
HOST_BIN := Duren_host

ifeq ($(HOST_SDL),3)
$(error Duren host uses SDL2 + SDL2_image only (got HOST_SDL=$(HOST_SDL)))
else ifneq ($(HOST_SDL),2)
$(error HOST_SDL must be 2 (got '$(HOST_SDL)'))
endif

HOST_PKG_CFLAGS := $(shell pkg-config --cflags sdl2 SDL2_image 2>/dev/null)
HOST_PKG_LIBS   := $(shell pkg-config --libs sdl2 SDL2_image 2>/dev/null)
HOST_PKG_LIBS   := $(filter-out -lSDL2main,$(HOST_PKG_LIBS))
ifeq ($(HOST_PKG_LIBS),)
$(warning pkg-config sdl2/SDL2_image not found — host link may fail.)
endif

# No PLATFORM_RETRO_GO: duren_game.c exposes duren_application_main().
HOST_DEFS := \
	-DHOST_BUILD=1 \
	-DHOST_SDL=2 \
	-DDUREN_APPLICATION_MAIN=1 \
	-DSDL_MAIN_HANDLED=1 \
	-DIS_LITTLE_ENDIAN

HOST_INCLUDES := \
	-Isrc/duren \
	$(HOST_PKG_CFLAGS)

HOST_CFLAGS := -O2 -g -Wall -Wextra -std=c11 \
	$(HOST_DEFS) $(HOST_INCLUDES)

HOST_GAME_SRCS := \
src/duren/duren_pak.c \
src/duren/duren_game.c \
src/duren/hal_sdl2.c \
src/duren/game.c \
src/duren/modes.c \
src/duren/tournament.c \
src/duren/ui_modes.c \
src/duren/battle_royal.c \
src/duren/battle_royal_ui.c \
src/duren/savegame.c \
src/duren/rng.c \
src/duren/dialogue_data.c \
src/duren/career_map.c \
src/duren/career_progress.c \
src/duren/assets.c \
src/duren/audio_assets.c

HOST_SRCS := \
	host/duren_host_main.c \
	$(HOST_GAME_SRCS)

HOST_OBJS := $(addprefix $(HOST_BUILD_DIR)/,$(HOST_SRCS:.c=.o))
HOST_DEPS := $(HOST_OBJS:.o=.d)

.PHONY: host host_clean host_run

host: $(HOST_BIN)
	$(V)$(ECHO) "[ HOST ]" $(HOST_BIN) "(SDL2 + SDL2_image)"
	$(V)$(ECHO) "  run: ./$(HOST_BIN)   (loads assets from ./host_data)"

$(HOST_BIN): $(HOST_OBJS)
	$(V)$(ECHO) [ LD HOST ] $@
	$(V)$(HOST_CC) -o $@ $(HOST_OBJS) $(HOST_PKG_LIBS) -lm

$(HOST_BUILD_DIR)/src/%.o: src/%.c
	$(V)mkdir -p $(dir $@)
	$(V)$(ECHO) [ CC HOST ] $<
	$(V)$(HOST_CC) $(HOST_CFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -c $< -o $@

$(HOST_BUILD_DIR)/host/%.o: host/%.c
	$(V)mkdir -p $(dir $@)
	$(V)$(ECHO) [ CC HOST ] $<
	$(V)$(HOST_CC) $(HOST_CFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -c $< -o $@

host_run: host
	./$(HOST_BIN)

host_clean:
	$(V)rm -rf build/host
	$(V)rm -f $(HOST_BIN)

clean:: host_clean

-include $(HOST_DEPS)
